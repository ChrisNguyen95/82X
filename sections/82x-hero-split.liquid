{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  /* ══════════════════════════════════════════════
     82X Hero Split  (#HeroSplit-ID)
  ══════════════════════════════════════════════ */

  /* ── Outer wrapper: full-width background ── */
  #HeroSplit-{{ section.id }} {
    display: flex;
    align-items: stretch;
  }

  /* ── Inner: constrain to page-width ── */
  #HeroSplit-{{ section.id }} .hs-page {
    width: 100%;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #HeroSplit-{{ section.id }} .hs-page {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Two-column grid ── */
  #HeroSplit-{{ section.id }} .hs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    min-height: {{ section.settings.min_height_mobile }}px;
  }
  @media screen and (min-width: 990px) {
    #HeroSplit-{{ section.id }} .hs-grid {
      grid-template-columns: {{ section.settings.content_width }}fr {{ 100 | minus: section.settings.content_width }}fr;
      gap: {{ section.settings.column_gap }}px;
      min-height: {{ section.settings.min_height }}px;
    }
    {%- if section.settings.image_position == 'left' -%}
      #HeroSplit-{{ section.id }} .hs-media  { order: 1; }
      #HeroSplit-{{ section.id }} .hs-content { order: 2; }
    {%- else -%}
      #HeroSplit-{{ section.id }} .hs-media  { order: 2; }
      #HeroSplit-{{ section.id }} .hs-content { order: 1; }
    {%- endif -%}
  }

  /* ── Mobile image order ── */
  @media screen and (max-width: 749px) {
    {%- if section.settings.mobile_image_first -%}
      #HeroSplit-{{ section.id }} .hs-media  { order: 1; }
      #HeroSplit-{{ section.id }} .hs-content { order: 2; }
    {%- else -%}
      #HeroSplit-{{ section.id }} .hs-media  { order: 2; }
      #HeroSplit-{{ section.id }} .hs-content { order: 1; }
    {%- endif -%}
  }

  /* ── Image column ── */
  #HeroSplit-{{ section.id }} .hs-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #HeroSplit-{{ section.id }} .hs-media img,
  #HeroSplit-{{ section.id }} .hs-media .placeholder-svg {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    max-height: {{ section.settings.min_height }}px;
  }
  @media screen and (max-width: 749px) {
    #HeroSplit-{{ section.id }} .hs-media img {
      max-height: 34rem;
    }
  }

  /* ── Content column — block spacing ── */
  #HeroSplit-{{ section.id }} .hs-content > * + * {
    margin-top: 2rem;
  }
  #HeroSplit-{{ section.id }} .hs-eyebrow + .hs-heading {
    margin-top: 1rem;
  }
  #HeroSplit-{{ section.id }} .hs-heading + .hs-text {
    margin-top: 1.6rem;
  }
  #HeroSplit-{{ section.id }} .hs-text + .hs-btn-wrap {
    margin-top: 2.8rem;
  }
  #HeroSplit-{{ section.id }} .hs-btn-wrap + .hs-icons {
    margin-top: 3.6rem;
  }

  /* ── Eyebrow ── */
  #HeroSplit-{{ section.id }} .hs-eyebrow {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(var(--color-foreground), 0.55);
    line-height: 1.4;
  }

  /* ── Heading ── */
  #HeroSplit-{{ section.id }} .hs-heading {
    margin: 0;
  }

  /* ── Text ── */
  #HeroSplit-{{ section.id }} .hs-text {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.75;
    color: rgba(var(--color-foreground), 0.75);
  }
  #HeroSplit-{{ section.id }} .hs-text p {
    margin: 0 0 1rem;
  }
  #HeroSplit-{{ section.id }} .hs-text p:last-child {
    margin-bottom: 0;
  }

  /* ── Button ── */
  #HeroSplit-{{ section.id }} .hs-btn-wrap {
    margin: 0;
  }
  #HeroSplit-{{ section.id }} .hs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 3.2rem;
    border-radius: 10rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border: 0.2rem solid {{ section.settings.btn_bg_color }};
  }
  #HeroSplit-{{ section.id }} .hs-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  #HeroSplit-{{ section.id }} .hs-btn--outline {
    background: transparent;
    color: {{ section.settings.btn_bg_color }};
  }
  #HeroSplit-{{ section.id }} .hs-btn--outline:hover {
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    opacity: 1;
  }

  /* ── Icons ── */
  #HeroSplit-{{ section.id }} .hs-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3.2rem;
    align-items: flex-start;
    margin: 0;
  }
  #HeroSplit-{{ section.id }} .hs-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    text-align: center;
  }
  #HeroSplit-{{ section.id }} .hs-icon-item img {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: block;
  }
  #HeroSplit-{{ section.id }} .hs-icon-label {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: var(--hs-icon-label-color, rgba(var(--color-foreground), 0.65));
    max-width: 8rem;
  }
{%- endstyle -%}

<div
  id="HeroSplit-{{ section.id }}"
  class="gradient color-{{ section.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="hs-page page-width">
    <div class="hs-grid">

      {%- comment -%}── Image ──{%- endcomment -%}
      <div class="hs-media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: fetch_priority,
              fetchpriority: fetch_priority,
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 990px) 55vw, 100vw',
              width: section.settings.image.width,
              height: section.settings.image.height
          }}
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- comment -%}── Content ──{%- endcomment -%}
      <div class="hs-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              {%- if block.settings.text != blank -%}
                <p class="hs-eyebrow" {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </p>
              {%- endif -%}

            {%- when 'heading' -%}
              <h2
                class="hs-heading {{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.heading }}
              </h2>

            {%- when 'text' -%}
              <div class="hs-text rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <div class="hs-btn-wrap" {{ block.shopify_attributes }}>
                  <a
                    {% if block.settings.button_link != blank %}
                      href="{{ block.settings.button_link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="hs-btn{% if block.settings.button_style == 'outline' %} hs-btn--outline{% endif %}"
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}

            {%- when 'icons' -%}
              {%- liquid
                assign has_icons = false
                for n in (1..5)
                  assign icon_key = 'icon_' | append: n
                  if block.settings[icon_key] != blank
                    assign has_icons = true
                    break
                  endif
                endfor
              -%}
              {%- if has_icons -%}
                <div
                  class="hs-icons"
                  {{ block.shopify_attributes }}
                  {% if block.settings.icon_label_color != blank %}
                    style="--hs-icon-label-color: {{ block.settings.icon_label_color }}"
                  {% endif %}
                >
                  {%- for n in (1..5) -%}
                    {%- liquid
                      assign icon_key  = 'icon_'  | append: n
                      assign label_key = 'label_' | append: n
                      assign icon_img  = block.settings[icon_key]
                      assign icon_lbl  = block.settings[label_key]
                    -%}
                    {%- if icon_img != blank -%}
                      <div class="hs-icon-item">
                        <img
                          src="{{ icon_img | image_url: width: 80 }}"
                          width="{{ section.settings.icon_size }}"
                          height="{{ section.settings.icon_size }}"
                          alt="{{ icon_lbl | escape }}"
                          loading="lazy"
                        >
                        {%- if icon_lbl != blank -%}
                          <p class="hs-icon-label">{{ icon_lbl | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "82X Hero Split",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Show image first on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Content column width",
      "default": 45
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Gap between columns",
      "default": 60
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Min height (desktop)",
      "default": 500
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Min height (mobile)",
      "default": 300
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Background color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#1a2744"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium Japanese Collagen Expert"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "The Art Of J-Beauty, Perfected Within"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Size",
          "options": [
            { "value": "h1", "label": "X-Large" },
            { "value": "h2", "label": "Large" },
            { "value": "h3", "label": "Medium" },
            { "value": "h4", "label": "Small" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>More than 10,000 happy customers have trusted and used our products to <strong>Support Their Skin And Overall Health</strong> — powered by premium quality and advanced technology.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            { "value": "filled",  "label": "Filled" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "filled"
        }
      ]
    },
    {
      "type": "icons",
      "name": "Icons",
      "limit": 1,
      "settings": [
        {
          "type": "color",
          "id": "icon_label_color",
          "label": "Label color",
          "info": "Leave blank to inherit text color"
        },
        {
          "type": "header",
          "content": "Icon 1"
        },
        {
          "type": "image_picker",
          "id": "icon_1",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Label",
          "default": "Beauty Placenta"
        },
        {
          "type": "header",
          "content": "Icon 2"
        },
        {
          "type": "image_picker",
          "id": "icon_2",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Label",
          "default": "Fish Collagen"
        },
        {
          "type": "header",
          "content": "Icon 3"
        },
        {
          "type": "image_picker",
          "id": "icon_3",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Label",
          "default": "Sakura Extract"
        },
        {
          "type": "header",
          "content": "Icon 4"
        },
        {
          "type": "image_picker",
          "id": "icon_4",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label_4",
          "label": "Label",
          "default": "Natural Ingredients"
        },
        {
          "type": "header",
          "content": "Icon 5"
        },
        {
          "type": "image_picker",
          "id": "icon_5",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label_5",
          "label": "Label",
          "default": "Made In Japan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "82X Hero Split",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" },
        { "type": "icons" }
      ]
    }
  ]
}
