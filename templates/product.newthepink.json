      "blocks": {
        "item_WaPpKd": {
          "type": "item",
          "settings": {
            "title": "What makes The Pink different from collagen powders?",
            "content": "<p>The Pink is a ready-to-drink beauty beverage designed for convenience.</p><p>No mixing. No measuring. No preparation.</p><p>Each bottle combines marine collagen peptides, Vitamin C, Ceramide, Hyaluronic Acid, B Vitamins, and 82 fermented plant extracts in a refreshing pineapple-flavored drink that fits easily into your daily routine.</p><p>Simply chill, open, and enjoy.</p>",
            "open_by_default": true
